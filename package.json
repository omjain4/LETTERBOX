{
  "name": "letterbox",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "npm run dev --workspace=apps/server & npm run dev --workspace=apps/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:web": "npm run dev --workspace=apps/web",
    "db:push": "npm run db:push --workspace=apps/server",
    "db:studio": "npm run db:studio --workspace=apps/server"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}